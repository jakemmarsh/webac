!packages/shared/src/routines/vtankExpr.ts
!packages/shared/src/routines/vtankOptions.ts
!packages/shared/src/routines/vtankProfile.ts
!packages/shared/src/routines/metaView.ts
!packages/renderer/src/agent/format.ts
!tools/ac-agent/client.ts
!tools/ac-agent/eras.ts
!tools/ac-agent/journal.ts
!tools/ac-agent/mcp-server.ts
!tools/ac-agent/routineStore.ts
!tools/ac-agent/state.ts
!tools/ac-agent/tools.ts
