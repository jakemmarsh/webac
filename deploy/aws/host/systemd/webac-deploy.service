[Unit]
Description=webac deploy agent: deploy the newest CI-green build of web and bridge (deploy/aws/host/deploy-agent.sh)
After=docker.service nginx.service network-online.target
Wants=network-online.target

[Service]
Type=oneshot
ExecStart=/bin/bash /opt/webac/repo/deploy/aws/host/deploy-agent.sh
# Pulls and health checks; images are built elsewhere (tools/build-push-images.sh).
TimeoutStartSec=30min
