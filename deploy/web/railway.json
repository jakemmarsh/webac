{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "DOCKERFILE",
    "dockerfilePath": "deploy/web/Dockerfile",
    "watchPatterns": [
      "packages/**",
      "services/**",
      "deploy/web/**",
      "tools/lib/vite-head-from-stat.ts",
      "vite.config.ts",
      "package.json",
      "package-lock.json",
      "tsconfig*.json"
    ]
  },
  "deploy": {
    "restartPolicyType": "ON_FAILURE",
    "restartPolicyMaxRetries": 10
  }
}
