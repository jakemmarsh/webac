{
	admin off
}

:{$PORT:8080} {
	root * /srv
	encode zstd gzip
	# Hashed bundle names: cache forever. index.html / config.json: always revalidate.
	header /assets/* Cache-Control "public, max-age=31536000, immutable"
	# The static pages' assets carry a content hash in their names too (tools/site/build-site.mjs).
	header /s/* Cache-Control "public, max-age=31536000, immutable"
	@html path / /index.html /about/ /about/index.html /how-to-play-asherons-call/ /how-to-play-asherons-call/index.html /servers/ /servers/index.html /mac-linux/ /mac-linux/index.html /eras/ /eras/index.html
	header @html Cache-Control "no-cache"
	header /config.json Cache-Control "no-store"
	header /version.json Cache-Control "no-store"
	header {
		Content-Security-Policy "{$ACJS_CSP}"
		Strict-Transport-Security "max-age=31536000; includeSubDomains"
		X-Content-Type-Options nosniff
		X-Frame-Options DENY
		Referrer-Policy strict-origin-when-cross-origin
		Permissions-Policy "camera=(), microphone=(), geolocation=(), payment=(), usb=()"
		Cross-Origin-Opener-Policy same-origin
		-Server
	}
	respond /healthz 200
	file_server
}
