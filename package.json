{
  "name": "acjs",
  "version": "0.1.0",
  "license": "AGPL-3.0-or-later",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/jakemmarsh/webac.git"
  },
  "private": true,
  "type": "module",
  "workspaces": [
    "packages/*",
    "services/*"
  ],
  "scripts": {
    "build": "tsc -b",
    "dev": "vite",
    "test": "vitest run",
    "check-stack": "tsx tools/check-stack.ts",
    "fix-stack": "tsx tools/check-stack.ts --fix",
    "test:file": "vitest run",
    "test:related": "vitest related --run",
    "test:changed": "vitest run --changed origin/main",
    "build:web": "vite build"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.8",
    "@types/pngjs": "^6.0.5",
    "@types/three": "^0.186.0",
    "@types/ws": "^8.5.10",
    "happy-dom": "^20.10.2",
    "megajs": "^1.3.10",
    "pixelmatch": "^7.2.0",
    "playwright": "^1.60.0",
    "pngjs": "^7.0.0",
    "tsx": "^4.23.15",
    "typescript": "^5.3.3",
    "vite": "^6.4.3",
    "vitest": "^4.1.11",
    "ws": "^8.22.0"
  },
  "dependencies": {
    "better-sqlite3": "^9.4.3",
    "three": "^0.186.1"
  }
}
